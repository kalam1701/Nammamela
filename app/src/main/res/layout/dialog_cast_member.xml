<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/white">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cast Member"
        android:textColor="@color/forest_green"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:layout_marginBottom="16dp"/>

    <EditText android:id="@+id/etCastName"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:hint="Name *"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:background="@drawable/bg_edit_text"
        android:paddingHorizontal="12dp"
        android:inputType="textPersonName" android:textSize="15sp"
        android:layout_marginBottom="10dp"/>

    <EditText android:id="@+id/etCastRole"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:hint="Role (Lead Actor / Comedian / Singer) *"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:background="@drawable/bg_edit_text"
        android:paddingHorizontal="12dp"
        android:textSize="15sp"
        android:layout_marginBottom="10dp"/>

    <EditText android:id="@+id/etCastBio"
        android:layout_width="match_parent" android:layout_height="80dp"
        android:hint="Bio (max 120 chars)"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:background="@drawable/bg_edit_text"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:inputType="textMultiLine"
        android:gravity="top" android:maxLength="120" android:textSize="15sp"
        android:layout_marginBottom="10dp"/>

    <EditText android:id="@+id/etCastPhoto"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:hint="Photo URL (optional)"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:background="@drawable/bg_edit_text"
        android:paddingHorizontal="12dp"
        android:inputType="textUri" android:textSize="15sp"/>

</LinearLayout>
