<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/white">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cast Member"
        android:textColor="@color/forest_green"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:layout_marginBottom="16dp"/>

    <EditText android:id="@+id/etCastName"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:hint="Name *"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:background="@drawable/bg_edit_text"
        android:paddingHorizontal="12dp"
        android:inputType="textPersonName" android:textSize="15sp"
        android:layout_marginBottom="10dp"/>

    <EditText android:id="@+id/etCastRole"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:hint="Role (Lead Actor / Comedian / Singer) *"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:background="@drawable/bg_edit_text"
        android:paddingHorizontal="12dp"
        android:textSize="15sp"
        android:layout_marginBottom="10dp"/>

    <EditText android:id="@+id/etCastBio"
        android:layout_width="match_parent" android:layout_height="80dp"
        android:hint="Bio (max 120 chars)"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:background="@drawable/bg_edit_text"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:inputType="textMultiLine"
        android:gravity="top" android:maxLength="120" android:textSize="15sp"
        android:layout_marginBottom="10dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <ImageView
            android:id="@+id/ivCastPhotoPreview"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_avatar"
            android:src="@drawable/ic_person"
            android:scaleType="centerCrop"/>

        <Button
            android:id="@+id/btnPickCastPhoto"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Upload Photo"
            android:textColor="@color/forest_green"
            android:backgroundTint="@color/bg_mint"
            android:textSize="14sp"
            style="?attr/materialButtonOutlinedStyle"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/btnCastCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/black"
            android:backgroundTint="@color/bg_mint"
            android:layout_marginEnd="12dp"
            style="?attr/materialButtonOutlinedStyle"/>

        <Button
            android:id="@+id/btnCastSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add"
            android:textColor="@color/black"
            android:backgroundTint="@color/forest_green"/>
    </LinearLayout>

</LinearLayout>
