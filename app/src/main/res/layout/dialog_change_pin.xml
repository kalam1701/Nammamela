<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/white">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Change PIN"
        android:textColor="@color/forest_green"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:layout_marginBottom="16dp"/>

    <EditText android:id="@+id/etCurrentPin"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:hint="Current PIN"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:background="@drawable/bg_edit_text"
        android:paddingHorizontal="12dp"
        android:inputType="numberPassword"
        android:textSize="15sp" android:layout_marginBottom="10dp"/>

    <EditText android:id="@+id/etNewPin"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:hint="New PIN (min 4 digits)"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:background="@drawable/bg_edit_text"
        android:paddingHorizontal="12dp"
        android:inputType="numberPassword"
        android:textSize="15sp" android:layout_marginBottom="10dp"/>

    <EditText android:id="@+id/etConfirmPin"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:hint="Confirm New PIN"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:background="@drawable/bg_edit_text"
        android:paddingHorizontal="12dp"
        android:inputType="numberPassword"
        android:textSize="15sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/black"
            android:backgroundTint="@color/bg_mint"
            android:layout_marginEnd="12dp"
            style="?attr/materialButtonOutlinedStyle"/>

        <Button
            android:id="@+id/btnChange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change"
            android:textColor="@color/black"
            android:backgroundTint="@color/forest_green"/>

    </LinearLayout>

</LinearLayout>
