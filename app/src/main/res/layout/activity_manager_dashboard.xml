<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_mint">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Section: Tonight's Play -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tonight's Play"
            android:textColor="@color/forest_green"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:paddingBottom="12dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <EditText android:id="@+id/etPlayTitle"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:hint="Play Title *" android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" android:background="@drawable/bg_edit_text"
                    android:paddingHorizontal="12dp" android:textSize="15sp" android:layout_marginBottom="10dp"/>

                <EditText android:id="@+id/etPlayGenre"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:hint="Genres (comma-separated: Drama, Comedy, Mythology)" android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" android:background="@drawable/bg_edit_text"
                    android:paddingHorizontal="12dp" android:textSize="15sp" android:layout_marginBottom="10dp"/>

                <EditText android:id="@+id/etPlayVenue"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:hint="Venue / Location (e.g. Dharwad Utsav Grounds)" android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" android:background="@drawable/bg_edit_text"
                    android:paddingHorizontal="12dp" android:textSize="15sp" android:layout_marginBottom="10dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <EditText android:id="@+id/etPlayDuration"
                        android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                        android:hint="Duration (mins)" android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary" android:background="@drawable/bg_edit_text"
                        android:paddingHorizontal="12dp" android:inputType="number" android:textSize="15sp"
                        android:layout_marginEnd="8dp"/>
                    <EditText android:id="@+id/etPlayDate"
                        android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                        android:hint="Date (e.g. 24 Oct)" android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary" android:background="@drawable/bg_edit_text"
                        android:paddingHorizontal="12dp" android:textSize="15sp"
                        android:layout_marginEnd="8dp"/>
                    <EditText android:id="@+id/etShowTime"
                        android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                        android:hint="Show Time (7:00 PM)" android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary" android:background="@drawable/bg_edit_text"
                        android:paddingHorizontal="12dp" android:textSize="15sp"/>
                </LinearLayout>

                <EditText android:id="@+id/etSynopsis"
                    android:layout_width="match_parent" android:layout_height="96dp"
                    android:hint="Synopsis / Description" android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" android:background="@drawable/bg_edit_text"
                    android:paddingHorizontal="12dp" android:paddingTop="10dp"
                    android:inputType="textMultiLine" android:gravity="top"
                    android:textSize="15sp" android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:id="@+id/ivPosterPreview"
                        android:layout_width="80dp"
                        android:layout_height="120dp"
                        android:layout_marginEnd="12dp"
                        android:background="@color/bg_light"
                        android:scaleType="centerCrop"/>

                    <Button
                        android:id="@+id/btnUploadPoster"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Select Poster Image"
                        android:backgroundTint="@color/bg_mint"
                        android:textColor="@color/forest_green"
                        style="?attr/materialButtonOutlinedStyle"/>
                </LinearLayout>

                <Button android:id="@+id/btnSavePlay"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:text="Save Play Details" android:textSize="15sp" android:textStyle="bold"
                    android:backgroundTint="@color/forest_green" android:textColor="@color/white"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Section: Cast -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Cast Members" android:textColor="@color/forest_green"
                android:textSize="18sp" android:textStyle="bold" android:fontFamily="serif"/>
            <Button android:id="@+id/btnAddCast"
                android:layout_width="wrap_content" android:layout_height="40dp"
                android:text="+ Add" android:textSize="13sp"
                android:backgroundTint="@color/forest_green" android:textColor="@color/white"
                android:paddingHorizontal="16dp"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvManagerCast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="20dp"/>

        <!-- Section: Seat Management -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Seat Management" android:textColor="@color/forest_green"
            android:textSize="18sp" android:textStyle="bold" android:fontFamily="serif"
            android:layout_marginBottom="12dp"/>

        <Button android:id="@+id/btnResetSeats"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Reset All Seats (Next Show)" android:textSize="15sp" android:textStyle="bold"
            android:backgroundTint="@color/white" android:textColor="@color/forest_green"
            android:layout_marginBottom="20dp"/>

        <!-- Section: Fan Wall Moderation -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Fan Wall Moderation" android:textColor="@color/forest_green"
            android:textSize="18sp" android:textStyle="bold" android:fontFamily="serif"
            android:layout_marginBottom="12dp"/>

        <TextView android:id="@+id/tvNoFanPosts"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="No fan posts yet." android:textColor="@color/text_secondary"
            android:textSize="14sp" android:gravity="center" android:paddingVertical="16dp"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvManagerPosts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="20dp"/>

        <!-- Section: Security -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Security" android:textColor="@color/forest_green"
            android:textSize="18sp" android:textStyle="bold" android:fontFamily="serif"
            android:layout_marginBottom="12dp"/>

        <Button android:id="@+id/btnChangePin"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Change Manager PIN" android:textSize="15sp" android:textStyle="bold"
            android:backgroundTint="@color/white" android:textColor="@color/forest_green"
            android:layout_marginBottom="32dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
